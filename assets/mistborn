#!/usr/bin/env bash
set -Eeuo pipefail

RUNTIPI_PATH="${RUNTIPI_PATH:-/opt/runtipi}"

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
task_event() {
  [[ -n "${MISTBORN_PROGRESS_FILE:-}" ]] || return 0
  printf '%s\t%s\t%s\n' "$1" "$2" "$3" >>"$MISTBORN_PROGRESS_FILE" || true
}
runtipi_cli() {
  if [[ -x "$RUNTIPI_PATH/runtipi-cli" ]]; then printf '%s\n' "$RUNTIPI_PATH/runtipi-cli"
  elif command -v runtipi-cli >/dev/null; then command -v runtipi-cli
  else die "runtipi-cli not found under $RUNTIPI_PATH or PATH"; fi
}
run_runtipi() { "$(runtipi_cli)" "$@"; }
app_refs() {
  local store app
  for store in "$RUNTIPI_PATH"/apps/*; do
    [[ -d "$store" ]] || continue
    for app in "$store"/*; do [[ -d "$app" ]] && printf '%s:%s\n' "$(basename "$app")" "$(basename "$store")"; done
  done
}
snapshot_apps() { local ref; while IFS= read -r ref; do run_runtipi app backup "$ref"; done; }
doctor() {
  local failures=0
  printf 'Mistborn host diagnostics\n'
  for command in docker tailscale rclone ufw fail2ban-client; do
    if command -v "$command" >/dev/null 2>&1; then printf '  PASS  %s installed\n' "$command"; else printf '  WARN  %s missing\n' "$command"; fi
  done
  if [[ -d "$RUNTIPI_PATH" ]]; then printf '  PASS  Runtipi directory: %s\n' "$RUNTIPI_PATH"; else printf '  FAIL  Runtipi directory missing\n'; failures=1; fi
  if docker info >/dev/null 2>&1; then printf '  PASS  Docker daemon reachable\n'; else printf '  FAIL  Docker daemon unreachable\n'; failures=1; fi
  if systemctl is-active --quiet fail2ban; then printf '  PASS  fail2ban active\n'; else printf '  WARN  fail2ban inactive\n'; fi
  if ufw status 2>/dev/null | grep -q 'Status: active'; then printf '  PASS  UFW active\n'; else printf '  WARN  UFW inactive\n'; fi
  return "$failures"
}
status() {
  doctor || true
  printf '\nService status\n'
  local service
  for service in docker tailscaled fail2ban; do
    if ! command -v systemctl >/dev/null 2>&1; then
      printf '  INFO  systemd unavailable; cannot inspect %s\n' "$service"
      break
    elif systemctl is-active --quiet "$service"; then
      printf '  PASS  %s active\n' "$service"
    else
      printf '  WARN  %s inactive\n' "$service"
    fi
  done
  if command -v tailscale >/dev/null 2>&1; then
    printf '\nTailscale\n'
    tailscale status || true
  fi
}
fix_services() {
  local service changed=0
  [[ "$EUID" == 0 ]] || die "run 'mistborn fix' with sudo"
  command -v systemctl >/dev/null 2>&1 || die "systemd is required to repair services"
  for service in docker tailscaled; do
    if ! command -v "$service" >/dev/null 2>&1; then
      printf '  SKIP  %s is not installed\n' "$service"
      continue
    fi
    if systemctl is-active --quiet "$service" && systemctl is-enabled --quiet "$service"; then
      printf '  PASS  %s is already enabled and active\n' "$service"
    else
      printf '  FIX   enabling and starting %s\n' "$service"
      systemctl enable --now "$service"
      changed=1
    fi
  done
  if [[ "$changed" == 0 ]]; then printf 'Core services are already healthy.\n'; fi
  printf 'UFW and SSH settings are left unchanged; review them with mistborn security-status.\n'
}
update_runtipi() {
  printf 'Updating Runtipi core (with app snapshots)...\n'
  task_event core update started
  snapshot_apps < <(app_refs)
  run_runtipi update latest
  task_event core update completed
  printf '\nUpdating app stores...\n'
  task_event appstores update started
  run_runtipi appstore update
  task_event appstores update completed
  printf '\nUpdating apps (with snapshots)...\n'
  task_event apps update started
  update_apps
  task_event apps update completed
  printf '\nMistborn updates complete.\n'
}
update_bootstrap() {
  [[ "$EUID" == 0 ]] || die "run 'mistborn upgrade' with sudo"
  local latest current temp_dir installer_url
  task_event bootstrap release started
  printf 'Checking the latest stable Mistborn Bootstrap release...\n'
  latest="$(curl -fsSL https://api.github.com/repos/EckPhi/mistborn-bootstrap/releases/latest | sed -nE 's/^[[:space:]]*"tag_name":[[:space:]]*"(v[0-9]+\.[0-9]+\.[0-9]+)".*/\1/p' | head -n1)" || die "could not check GitHub releases"
  [[ "$latest" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "GitHub returned no stable bootstrap release"
  task_event bootstrap release completed
  current="${MISTBORN_BOOTSTRAP_VERSION:-v0.0.0}"
  current="${current#v}"
  latest="${latest#v}"
  if [[ "$(printf '%s\n%s\n' "$current" "$latest" | sort -V | tail -n1)" == "$current" ]]; then
    printf 'Mistborn Bootstrap %s is already current.\n' "$current"
    task_event bootstrap installer skipped
    return 0
  fi
  installer_url="https://raw.githubusercontent.com/EckPhi/mistborn-bootstrap/v${latest}/install.sh"
  temp_dir="$(mktemp -d)"
  trap 'rm -rf "$temp_dir"' RETURN
  task_event bootstrap installer started
  printf 'Updating Mistborn Bootstrap %s → %s...\n' "$current" "$latest"
  curl -fsSL "$installer_url" -o "$temp_dir/install.sh" || die "could not download bootstrap installer"
  MISTBORN_VERSION="v${latest}" MISTBORN_TUI=0 bash "$temp_dir/install.sh" server --yes
  task_event bootstrap installer completed
  printf 'Mistborn Bootstrap updated to %s.\n' "$latest"
}
update_apps() {
  local backup=1 refs=() ref
  [[ "${1:-}" == --no-backup ]] && { backup=0; shift; }
  if [[ $# -gt 0 ]]; then refs=("$@"); else mapfile -t refs < <(app_refs); fi
  for ref in "${refs[@]}"; do [[ "$backup" == 1 ]] && run_runtipi app backup "$ref"; run_runtipi app update "$ref"; done
}
usage() {
  cat <<'EOF'
Usage: mistborn COMMAND [ARGS]
  status                       show installation, service and Tailscale status
  doctor                       audit Docker, Runtipi, Tailscale, rclone and security
  fix                          enable and start installed Docker/Tailscale services
  security-status              show SSH, UFW, fail2ban and Tailscale status
  tailscale-status             show Tailscale status
  rclone-config                open rclone's configuration UI
  update-apps [--no-backup] [APP:STORE ...]
  update-core [--no-backup] [VERSION]
  update-appstores
  upgrade                      upgrade Mistborn Bootstrap to the latest stable release
  update                       alias for upgrade
  update-runtipi               update Runtipi core, app stores and apps (with backups)
EOF
}
case "${1:-}" in
  help|-h|--help|'') usage ;;
  status) status ;;
  doctor) doctor ;;
  fix) fix_services ;;
  security-status) sshd -T 2>/dev/null | grep -E 'passwordauthentication|permitrootlogin|^port'; ufw status verbose; fail2ban-client status sshd || true; tailscale status || true ;;
  tailscale-status) tailscale status ;;
  rclone-config) rclone config ;;
  update-apps) shift; update_apps "$@" ;;
  update-core) shift; backup=1; [[ "${1:-}" == --no-backup ]] && { backup=0; shift; }; [[ "$backup" == 1 ]] && snapshot_apps < <(app_refs); run_runtipi update "${1:-latest}" ;;
  update-appstores) run_runtipi appstore update ;;
  upgrade|update) update_bootstrap ;;
  update-runtipi) update_runtipi ;;
  *) die "unknown command: $1" ;;
esac
